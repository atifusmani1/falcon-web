# Base URL for the Python backend API (no trailing slash).
# Leave blank for local development: the frontend will simulate
# successful submissions and log the payload to the console.
#
# Example:
#   VITE_API_BASE_URL=http://localhost:8000
VITE_API_BASE_URL=

# Jotform API key used by netlify/functions/mosque-security-intake.mjs to
# forward Mosque Security Initiative intake submissions to Jotform form
# 262316142653048. Required in the Netlify site's environment variables —
# without it, every submission on that page fails with a 503.
JOTFORM_API_KEY=
